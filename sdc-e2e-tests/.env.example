# Copier en .env pour un lancement LOCAL uniquement (jamais commiter .env).
# En CI (GitHub Actions), ces valeurs viennent des Organization Variables/Secrets
# eFlip (ADMIN1/ADMIN2/SHAREPOINTTEST1/SHAREPOINTTEST2) — voir
# .github/workflows/sdc-e2e.yml pour le mapping rôle -> compte.

# Environnement Power Platform GOC_DEV
POWERPLATFORM_ENV_ID=cade14ab-65b6-e790-bb35-f1e938f76958
POWERPLATFORM_APP_ID=79fd1605-4557-46ce-824a-677df11842f7

# Identifiants du rôle joué par CE run (un seul rôle à la fois). En local,
# reprendre la valeur du compte correspondant au rôle (voir tableau dans README.md).
SDC_TEST_EMAIL=
SDC_TEST_PASSWORD=

# ID de la demande créée par le job "demandeur", transmis aux jobs suivants
# (rempli automatiquement par le workflow CI ; laisser vide en local et le
# renseigner à la main pour rejouer un scénario sur une demande existante).
SDC_ITEM_TITLE=
